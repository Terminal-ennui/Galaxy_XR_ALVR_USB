+/// Requests every permission that is not granted yet in a single request. Separate back-to-back
+/// requests are not reliably all shown.
+pub fn try_get_permissions(permissions: &[&str]) {
+    let vm = vm();
+    let mut env = vm.attach_current_thread().unwrap();
+
+    let mut missing_permissions = vec![];
+    for permission in permissions {
+        let permission = env.new_string(permission).unwrap();
+        let permission_status = env
+            .call_method(
+                unsafe { JObject::from_raw(context()) },
+                "checkSelfPermission",
+                "(Ljava/lang/String;)I",
+                &[(&permission).into()],
+            )
+            .unwrap()
+            .i()
+            .unwrap();
+        if permission_status != 0 {
+            missing_permissions.push(permission);
+        }
+    }
+
+    if missing_permissions.is_empty() {
+        return;
+    }
+
+    let string_class = env.find_class("java/lang/String").unwrap();
+    let permission_array = env
+        .new_object_array(missing_permissions.len() as i32, string_class, JObject::null())
+        .unwrap();
+    for (index, permission) in missing_permissions.iter().enumerate() {
+        env.set_object_array_element(&permission_array, index as i32, permission)
+            .unwrap();
+    }
+
+    env.call_method(
+        unsafe { JObject::from_raw(context()) },
+        "requestPermissions",
+        "([Ljava/lang/String;I)V",
+        &[(&permission_array).into(), 0.into()],
+    )
+    .unwrap();
+}
